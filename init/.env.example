# =============================================================================
# web-cli environment variables for {$ENV} token references in config.json
# =============================================================================
#
# Reference these from config.json, e.g.:
#   "api_token": "{$TAVILY_API_KEY}"
#
# Key signup pages:
#   TAVILY_API_KEY      https://app.tavily.com/
#   BRAVE_API_KEY       https://brave.com/search/api/
#   JINA_API_KEY        https://jina.ai/
#   FIRECRAWL_API_KEY   https://www.firecrawl.dev/
#   PERPLEXITY_API_KEY  https://www.perplexity.ai/settings/api
#
# Keys may also be written inline (plaintext) directly in config.json.
# =============================================================================

TAVILY_API_KEY=

BRAVE_API_KEY=

JINA_API_KEY=

FIRECRAWL_API_KEY=

PERPLEXITY_API_KEY=
